<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Polda: Najdi Notebook" 
        WindowState="Maximized" 
        WindowStyle="None" 
        Background="Black">

    <Window.Resources>
        <Style x:Key="HotspotStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#CC000000"/>
            <Setter Property="Foreground" Value="Yellow"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontFamily" Value="Impact"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" BorderBrush="Yellow" BorderThickness="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="Yellow"/>
                    <Setter Property="Foreground" Value="Black"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Viewbox Stretch="Uniform">
        <Canvas x:Name="GameCanvas" Width="800" Height="470">

            <Image x:Name="BackgroundImage" Width="800" Height="470" Stretch="Fill"/>

            <TextBlock x:Name="Menu_Title" Text="NAJDI NOTEBOOK" Canvas.Left="0" Canvas.Top="50" Width="800" 
                       TextAlignment="Center" Foreground="Yellow" FontSize="70" FontFamily="Impact">
                <TextBlock.Effect>
                    <DropShadowEffect BlurRadius="10" Color="Black" ShadowDepth="5"/>
                </TextBlock.Effect>
            </TextBlock>

            <Button x:Name="Menu_NewGame" Style="{StaticResource MenuButtonStyle}" Content="NOVÁ HRA" 
                    Canvas.Left="300" Canvas.Top="220" Width="200" Height="60" Click="Menu_NewGame_Click"/>

            <Button x:Name="Menu_Exit" Style="{StaticResource MenuButtonStyle}" Content="UKONČIT" 
                    Canvas.Left="300" Canvas.Top="300" Width="200" Height="60" Click="Menu_Exit_Click"/>


            <Button x:Name="Hotspot_BarDoor" Style="{StaticResource HotspotStyle}" Canvas.Left="505" Canvas.Top="145" Width="75" Height="130" Click="GoToOffice_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_Manhole" Style="{StaticResource HotspotStyle}" Canvas.Left="40" Canvas.Top="370" Width="160" Height="70" Click="GoToBasement_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_Trash" Style="{StaticResource HotspotStyle}" Canvas.Left="580" Canvas.Top="230" Width="200" Height="160" Click="ExamineTrash_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_PC" Style="{StaticResource HotspotStyle}" Canvas.Left="95" Canvas.Top="160" Width="140" Height="130" Click="ExaminePC_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_Desk" Style="{StaticResource HotspotStyle}" Canvas.Left="150" Canvas.Top="320" Width="200" Height="90" Click="ExamineDesk_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_Cabinet" Style="{StaticResource HotspotStyle}" Canvas.Left="590" Canvas.Top="100" Width="170" Height="330" Click="SearchCabinet_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_ExitOffice" Style="{StaticResource HotspotStyle}" Canvas.Left="0" Canvas.Top="420" Width="800" Height="50" Click="GoToStreet_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_Keypad" Style="{StaticResource HotspotStyle}" Canvas.Left="255" Canvas.Top="150" Width="60" Height="80" Click="UseKeypad_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_VaultDoor" Style="{StaticResource HotspotStyle}" Canvas.Left="30" Canvas.Top="100" Width="210" Height="310" Click="OpenVault_Click" Visibility="Collapsed"/>
            <Button x:Name="Hotspot_ExitBasement" Style="{StaticResource HotspotStyle}" Canvas.Left="0" Canvas.Top="420" Width="800" Height="50" Click="GoToStreet_Click" Visibility="Collapsed"/>

            <Border x:Name="DialoguePanel" Canvas.Bottom="60" Canvas.Left="10" Width="780" Background="#EE000000" CornerRadius="5" Visibility="Collapsed" MouseLeftButtonDown="HideDialogue_Click" Cursor="Hand">
                <TextBlock x:Name="TxtDialogue" Foreground="Yellow" FontSize="22" TextWrapping="Wrap" Padding="15" FontFamily="Arial"/>
            </Border>

        </Canvas>
    </Viewbox>
</Window>